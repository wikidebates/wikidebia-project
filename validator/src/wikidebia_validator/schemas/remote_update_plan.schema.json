{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "remote_update_plan.schema.json",
  "title": "Wikidéb'IA — Plan de reprise distante",
  "type": "object",
  "required": [
    "plan_version",
    "kit_version",
    "required_validator_version",
    "debate_id",
    "corpus_version",
    "languages",
    "state_source",
    "new_manifest_sha256",
    "validator_report_sha256",
    "config_sha256",
    "operations",
    "comparisons",
    "counts",
    "preconditions",
    "plan_sha256"
  ],
  "properties": {
    "plan_version": {
      "const": "wikidebia-remote-update-plan-1.0"
    },
    "kit_version": {
      "type": "string",
      "minLength": 1
    },
    "required_validator_version": {
      "type": "string",
      "minLength": 1
    },
    "debate_id": {
      "type": "string",
      "minLength": 1
    },
    "corpus_version": {
      "type": "string",
      "minLength": 1
    },
    "languages": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "fr",
          "en"
        ]
      }
    },
    "scope_mode": {
      "enum": [
        "all",
        "no_delete",
        "only_delete"
      ]
    },
    "state_source": {
      "type": "object",
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "published_state_receipt",
            "workflow_release_baseline",
            "previous_installed_manifest",
            "remote_inventory"
          ]
        }
      },
      "additionalProperties": true
    },
    "new_manifest_sha256": {
      "$ref": "common.schema.json#/$defs/sha256"
    },
    "validator_report_sha256": {
      "$ref": "common.schema.json#/$defs/sha256"
    },
    "config_sha256": {
      "$ref": "common.schema.json#/$defs/sha256"
    },
    "operations": {
      "type": "object",
      "required": [
        "create",
        "update",
        "move",
        "redirect",
        "delete",
        "skip",
        "manual_review",
        "blocked"
      ],
      "properties": {
        "create": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/operation"
          }
        },
        "update": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/operation"
          }
        },
        "move": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/operation"
          }
        },
        "redirect": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/operation"
          }
        },
        "delete": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/operation"
          }
        },
        "skip": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/operation"
          }
        },
        "manual_review": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/operation"
          }
        },
        "blocked": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/operation"
          }
        }
      },
      "additionalProperties": false
    },
    "comparisons": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/comparison"
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "preconditions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "plan_sha256": {
      "$ref": "common.schema.json#/$defs/sha256"
    },
    "edit_summary_contract": {
      "enum": [
        "page_specific_v1"
      ]
    }
  },
  "$defs": {
    "operation": {
      "type": "object",
      "required": [
        "wiki",
        "language",
        "title",
        "page_id",
        "page_type",
        "old_sha256",
        "new_sha256",
        "expected_revision_id",
        "observed_revision_id",
        "justification",
        "preconditions",
        "result",
        "phase"
      ],
      "properties": {
        "wiki": {
          "type": "string",
          "minLength": 1
        },
        "language": {
          "enum": [
            "fr",
            "en"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "page_id": {
          "type": "string",
          "minLength": 1
        },
        "page_type": {
          "type": "string",
          "minLength": 1
        },
        "old_sha256": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "new_sha256": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "expected_revision_id": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "observed_revision_id": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "justification": {
          "type": "string",
          "minLength": 1
        },
        "preconditions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "result": {
          "type": [
            "object",
            "null"
          ]
        },
        "phase": {
          "type": "integer",
          "minimum": 0
        },
        "comparison_id": {
          "type": "string",
          "minLength": 1
        },
        "edit_summary_policy": {
          "enum": [
            "corpus_page_creation",
            "content_diff_v1",
            "french_interlanguage_addition",
            "canonical_title_move_v1",
            "merge_redirect_v1",
            "retirement_v1"
          ]
        },
        "edit_summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      },
      "additionalProperties": true
    },
    "comparison": {
      "type": "object",
      "required": [
        "language",
        "page_id",
        "title",
        "published_sha256",
        "remote_sha256",
        "proposed_sha256",
        "diffs",
        "comparison_id"
      ],
      "properties": {
        "language": {
          "enum": [
            "fr",
            "en"
          ]
        },
        "page_id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "published_sha256": {
          "$ref": "common.schema.json#/$defs/sha256"
        },
        "remote_sha256": {
          "$ref": "common.schema.json#/$defs/sha256"
        },
        "proposed_sha256": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "diffs": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "comparison_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
