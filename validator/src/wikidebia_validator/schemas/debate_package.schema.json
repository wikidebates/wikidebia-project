{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "debate_package.schema.json",
  "title": "Wikidéb'IA — Manifeste du paquet d'un débat",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "package_schema_version": {
      "$ref": "common.schema.json#/$defs/version"
    },
    "debate_id": {
      "$ref": "common.schema.json#/$defs/debateId"
    },
    "short_code": {
      "$ref": "common.schema.json#/$defs/shortCode"
    },
    "global_status": {
      "$ref": "common.schema.json#/$defs/globalStatus"
    },
    "created_at": {
      "$ref": "common.schema.json#/$defs/dateTime"
    },
    "updated_at": {
      "$ref": "common.schema.json#/$defs/dateTime"
    },
    "normative_versions": {
      "$ref": "common.schema.json#/$defs/normativeVersions"
    },
    "core_files": {
      "type": "object",
      "properties": {
        "scope": {
          "$ref": "common.schema.json#/$defs/relativePath"
        },
        "registry": {
          "$ref": "common.schema.json#/$defs/relativePath"
        },
        "graph_json": {
          "$ref": "common.schema.json#/$defs/relativePath"
        },
        "graph_markdown": {
          "$ref": "common.schema.json#/$defs/relativePath"
        },
        "sources": {
          "$ref": "common.schema.json#/$defs/relativePath"
        }
      },
      "additionalProperties": false,
      "required": [
        "scope",
        "registry",
        "graph_json",
        "graph_markdown",
        "sources"
      ]
    },
    "pages": {
      "type": "array",
      "items": {
        "$ref": "page_manifest.schema.json"
      }
    },
    "batches": {
      "type": "array",
      "items": {
        "$ref": "batch_manifest.schema.json"
      }
    },
    "works": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "work_id": {
            "type": "string",
            "minLength": 1
          },
          "work_type": {
            "$ref": "common.schema.json#/$defs/workType"
          },
          "conversation_name": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "planned",
              "in_progress",
              "completed",
              "blocked",
              "obsolete"
            ]
          },
          "input_handoff": {
            "$ref": "common.schema.json#/$defs/nullableRelativePath"
          },
          "output_handoff": {
            "$ref": "common.schema.json#/$defs/nullableRelativePath"
          },
          "started_at": {
            "$ref": "common.schema.json#/$defs/nullableDateTime"
          },
          "completed_at": {
            "$ref": "common.schema.json#/$defs/nullableDateTime"
          }
        },
        "additionalProperties": false,
        "required": [
          "work_id",
          "work_type",
          "conversation_name",
          "status",
          "input_handoff",
          "output_handoff",
          "started_at",
          "completed_at"
        ]
      }
    },
    "validations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/validationId"
          },
          "scope": {
            "$ref": "common.schema.json#/$defs/validationScope"
          },
          "language": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "common.schema.json#/$defs/language"
              }
            ]
          },
          "validator_version": {
            "$ref": "common.schema.json#/$defs/version"
          },
          "executed_at": {
            "$ref": "common.schema.json#/$defs/dateTime"
          },
          "input_sha256": {
            "$ref": "common.schema.json#/$defs/sha256"
          },
          "result": {
            "$ref": "common.schema.json#/$defs/validationResult"
          },
          "blocking_errors": {
            "type": "integer",
            "minimum": 0
          },
          "warnings": {
            "type": "integer",
            "minimum": 0
          },
          "report_path": {
            "$ref": "common.schema.json#/$defs/relativePath"
          }
        },
        "additionalProperties": false,
        "required": [
          "id",
          "scope",
          "language",
          "validator_version",
          "executed_at",
          "input_sha256",
          "result",
          "blocking_errors",
          "warnings",
          "report_path"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "result": {
                  "enum": [
                    "passed",
                    "passed_with_warnings"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "blocking_errors": {
                  "const": 0
                }
              }
            }
          }
        ]
      }
    },
    "release": {
      "type": "object",
      "properties": {
        "release_manifest_path": {
          "$ref": "common.schema.json#/$defs/nullableRelativePath"
        },
        "release_zip_path": {
          "$ref": "common.schema.json#/$defs/nullableRelativePath"
        },
        "released_at": {
          "$ref": "common.schema.json#/$defs/nullableDateTime"
        },
        "archived_at": {
          "$ref": "common.schema.json#/$defs/nullableDateTime"
        },
        "release_receipt_path": {
          "$ref": "common.schema.json#/$defs/nullableRelativePath"
        }
      },
      "additionalProperties": false,
      "required": [
        "release_manifest_path",
        "release_zip_path",
        "released_at",
        "archived_at",
        "release_receipt_path"
      ]
    },
    "publication_gate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "local_release_status": {
          "type": "string",
          "enum": [
            "corrective_in_progress",
            "corrective_blocked",
            "release_ready"
          ]
        },
        "remote_write_authorized": {
          "type": "boolean"
        },
        "remote_template_compatibility": {
          "type": "string",
          "enum": [
            "blocked",
            "passed",
            "not_checked"
          ]
        },
        "blocking_reason": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1
            }
          ]
        },
        "checked_at": {
          "$ref": "common.schema.json#/$defs/dateTime"
        }
      },
      "required": [
        "local_release_status",
        "remote_write_authorized",
        "remote_template_compatibility",
        "blocking_reason",
        "checked_at"
      ]
    },
    "editorial_controls": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "creation_date": {
          "type": "string",
          "format": "date"
        },
        "individual_review_path": {
          "$ref": "common.schema.json#/$defs/relativePath"
        },
        "individual_review_report_path": {
          "$ref": "common.schema.json#/$defs/relativePath"
        },
        "keyword_vocabulary_path": {
          "$ref": "common.schema.json#/$defs/relativePath"
        },
        "required_reports": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/relativePath"
          },
          "uniqueItems": true
        },
        "debate_documentation": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "min_subsections": {
              "type": "integer",
              "minimum": 1
            },
            "min_references": {
              "type": "integer",
              "minimum": 0
            },
            "reject_singleton_bucket_pattern": {
              "type": "boolean"
            },
            "profile_rationale": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "min_subsections",
            "min_references",
            "reject_singleton_bucket_pattern"
          ]
        },
        "introduction_references": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "required": {
              "type": "boolean",
              "description": "Déclare le contrôle documentaire des introductions ; la règle active ne fixe aucun nombre minimal mécanique d’appels inline."
            },
            "min_subsections": {
              "type": "integer",
              "minimum": 1,
              "description": "Champ historique de compatibilité ; les minima structurels actifs sont déclarés dans debate_documentation."
            },
            "punctuation_policy_revision": {
              "type": "string",
              "pattern": "^\\d+\\.\\d+\\.\\d+$",
              "description": "Métadonnée historique de traçabilité; n’active ni ne désactive aucun contrôle éditorial."
            }
          },
          "required": [
            "required"
          ]
        },
        "summary_style_review_path": {
          "$ref": "common.schema.json#/$defs/relativePath"
        },
        "summary_style": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "min_sentences": {
              "type": "integer",
              "minimum": 2,
              "maximum": 10
            },
            "long_sentence_words": {
              "type": "integer",
              "minimum": 20,
              "maximum": 80
            },
            "max_average_sentence_words": {
              "type": "number",
              "minimum": 15,
              "maximum": 50
            },
            "max_long_sentence_ratio": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "max_sentence_words": {
              "type": "integer",
              "minimum": 30,
              "maximum": 120
            },
            "opening_title_similarity_enabled": {
              "type": "boolean"
            },
            "opening_similarity_threshold": {
              "type": "number",
              "minimum": 0.5,
              "maximum": 1
            },
            "opening_max_extra_significant_words": {
              "type": "integer",
              "minimum": 0,
              "maximum": 20
            },
            "quantitative_claim_review_required": {
              "type": "boolean"
            }
          },
          "required": [
            "enabled",
            "min_sentences",
            "long_sentence_words",
            "max_average_sentence_words",
            "max_long_sentence_ratio",
            "max_sentence_words"
          ]
        },
        "introduction_review_path": {
          "$ref": "common.schema.json#/$defs/relativePath"
        },
        "graph_placement_review_path": {
          "$ref": "common.schema.json#/$defs/relativePath"
        },
        "creation_date_policy": {
          "type": "string",
          "enum": [
            "single_active_date",
            "per_page_preserved"
          ]
        },
        "displayed_title_identity_exception": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "language": {
              "type": "string",
              "enum": [
                "fr",
                "en"
              ]
            },
            "scope": {
              "type": "string",
              "enum": [
                "legacy_owner_locked_import"
              ]
            },
            "owner_decision": {
              "type": "boolean"
            },
            "reason": {
              "type": "string",
              "minLength": 40
            },
            "review_path": {
              "$ref": "common.schema.json#/$defs/relativePath"
            }
          },
          "required": [
            "enabled",
            "language",
            "scope",
            "owner_decision",
            "reason",
            "review_path"
          ]
        },
        "quality_policy_revision": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "description": "Métadonnée historique de traçabilité; n’active ni ne désactive aucun contrôle éditorial."
        },
        "keyword_policy_revision": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "description": "Métadonnée historique de traçabilité; n’active ni ne désactive aucun contrôle éditorial."
        },
        "summary_policy_revision": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "description": "Métadonnée historique de traçabilité; n’active ni ne désactive aucun contrôle éditorial."
        },
        "capitalization_policy_revision": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "description": "Métadonnée historique de traçabilité; n’active ni ne désactive aucun contrôle éditorial."
        },
        "legacy_content_preservation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "lock_path",
            "protected_fields",
            "source_archive_sha256",
            "source_inventory_path",
            "source_inventory_sha256"
          ],
          "properties": {
            "enabled": {
              "const": true
            },
            "lock_path": {
              "type": "string",
              "minLength": 1
            },
            "protected_fields": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "résumé",
                  "summary",
                  "initialisation",
                  "initialization",
                  "débat-dédié",
                  "débat-détaillé",
                  "dedicated-debate",
                  "detailed-debate",
                  "nom",
                  "name",
                  "nom-consacré",
                  "established-name",
                  "all-existing-parameters"
                ]
              }
            },
            "source_archive_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "verification_revision": {
              "type": "string",
              "pattern": "^\\d+\\.\\d+\\.\\d+$",
              "description": "Métadonnée historique de traçabilité de la version du validateur; la vérification courante s’applique indépendamment de cette valeur."
            },
            "source_inventory_path": {
              "type": "string",
              "minLength": 1
            },
            "source_inventory_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "historical_summary_absence_revision": {
              "type": "string",
              "pattern": "^\\d+\\.\\d+\\.\\d+$",
              "description": "Métadonnée historique de traçabilité; n’active ni ne désactive aucun contrôle éditorial."
            },
            "historical_parameter_restoration": {
              "type": "boolean"
            }
          }
        },
        "displayed_title_policy_revision": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "description": "Métadonnée historique de traçabilité; n’active ni ne désactive aucun contrôle éditorial."
        },
        "debate_documentation_policy_revision": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "description": "Métadonnée historique de traçabilité; n’active ni ne désactive aucun contrôle éditorial."
        },
        "introduction_policy_revision": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "description": "Métadonnée historique de traçabilité; n’active ni ne désactive aucun contrôle éditorial."
        },
        "video_authorship_policy_revision": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "description": "Métadonnée historique de traçabilité; n’active ni ne désactive aucun contrôle éditorial."
        },
        "displayed_title_policy_scope": {
          "type": "string",
          "enum": [
            "all_active_nodes",
            "generated_pages_only"
          ],
          "description": "Limite la nouvelle revue sémantique aux pages générées lorsqu’un verrou historique atteste les pages importées."
        },
        "inline_reference_punctuation_policy_revision": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "description": "Métadonnée historique de traçabilité; n’active ni ne désactive aucun contrôle éditorial."
        },
        "wikipedia_link_consistency_policy_revision": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "description": "Métadonnée historique de traçabilité; n’active ni ne désactive aucun contrôle éditorial."
        },
        "specialized_term_explanation_policy_revision": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "description": "Métadonnée historique de traçabilité; n’active ni ne désactive aucun contrôle éditorial."
        },
        "manual_remote_adoption_revision": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "description": "Métadonnée historique de traçabilité; n’active ni ne désactive aucun contrôle éditorial."
        },
        "manual_remote_adoption_path": {
          "type": "string",
          "minLength": 1
        },
        "argument_name_assignment_revision": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "description": "Métadonnée historique de traçabilité; n’active ni ne désactive aucun contrôle éditorial."
        },
        "argument_name_assignment_path": {
          "type": "string",
          "minLength": 1
        },
        "argument_name_discovery_revision": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "description": "Métadonnée historique de traçabilité; n’active ni ne désactive aucun contrôle éditorial."
        },
        "argument_name_discovery_path": {
          "type": "string",
          "minLength": 1
        },
        "translation_validation_mode": {
          "type": "string",
          "enum": [
            "absolute",
            "differential"
          ],
          "description": "Differential validates translated form as non-regression against the authoritative source; absolute remains the creation-mode default."
        },
        "translation_semantic_review_schema_version": {
          "type": "string",
          "enum": [
            "1.0",
            "1.1",
            "1.2",
            "1.3",
            "1.4"
          ],
          "description": "Artifact schema for bilingual semantic-review attestations. Version 1.3 binds field-level evidence, proposition-edge review and semantic-risk evidence. Version 1.4 autorise les changements idiomatiques de forme avec revue explicite, étend les preuves de risques et les preuves de Debate."
        },
        "documentary_resource_registry_path": {
          "$ref": "common.schema.json#/$defs/relativePath"
        },
        "documentary_resource_registry_schema_version": {
          "type": "string",
          "enum": [
            "1.0"
          ],
          "description": "Version du registre corpus-wide qui sépare l'identité canonique d'une ressource de ses usages documentaires localisés."
        },
        "semantic_marker_engine_version": {
          "type": "string",
          "enum": [
            "1.0",
            "1.1",
            "1.2",
            "1.3"
          ],
          "description": "Version de l’analyse conservative des marqueurs sémantiques FR→EN; 1.2 ajoute les familles de risques issues des erreurs réelles corrigées. Version 1.3 aligne le catalogue de marqueurs kit/validateur et ajoute les glissements lexicaux issus du corpus réel de régressions."
        },
        "quote_completeness_review_schema_version": {
          "type": "string",
          "enum": [
            "1.0"
          ],
          "description": "Version de l’attestation humaine de complétude Citation→Quote; un ratio faible exige une seconde revue explicite sans devenir une preuve automatique de troncation."
        },
        "semantic_convergence_review_path": {
          "$ref": "common.schema.json#/$defs/relativePath"
        },
        "publication_url_replacements_path": {
          "$ref": "common.schema.json#/$defs/relativePath",
          "description": "Registre propriétaire des substitutions d’URL appliquées uniquement au texte de publication, sans modifier la source éditoriale verrouillée."
        },
        "english_successor_revisions_path": {
          "$ref": "common.schema.json#/$defs/relativePath",
          "description": "Registre propriétaire des révisions anglaises successives auditées après le verrouillage sémantique."
        },
        "semantic_convergence_review_schema_version": {
          "type": "string",
          "enum": [
            "1.0",
            "1.1"
          ],
          "description": "Reçu de deux passes sémantiques indépendantes consécutives lié à la revue de traduction scellée. La version 1.1 ajoute une famille de méthode normalisée et exige deux familles distinctes pour les passes finales."
        },
        "historical_text_render_validation_mode": {
          "type": "string",
          "enum": [
            "differential_preservation_v1"
          ],
          "description": "Mode de validation différentielle du rendu des textes historiques attestés; ne s’applique pas aux contenus nouveaux ou non attestés."
        }
      },
      "required": [
        "creation_date",
        "individual_review_path",
        "individual_review_report_path",
        "keyword_vocabulary_path",
        "required_reports",
        "debate_documentation",
        "introduction_references"
      ]
    },
    "traceability_controls": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "current_corrective_work_id": {
          "type": "string",
          "minLength": 1
        },
        "current_handoff_path": {
          "$ref": "common.schema.json#/$defs/relativePath"
        },
        "required_corrective_handoffs": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/relativePath"
          },
          "uniqueItems": true
        },
        "remote_write_must_be_false": {
          "type": "boolean"
        }
      },
      "required": [
        "current_corrective_work_id",
        "current_handoff_path",
        "required_corrective_handoffs",
        "remote_write_must_be_false"
      ]
    },
    "translation_status": {
      "type": "object",
      "description": "État explicite de la traduction anglaise. Le statut deferred est une capacité de workflow rétrocompatible : il autorise une publication française autonome lorsqu'il est déclaré explicitement, sans migrer le corpus vers une norme éditoriale plus récente.",
      "additionalProperties": false,
      "properties": {
        "en": {
          "type": "string",
          "enum": [
            "pending",
            "deferred",
            "ready",
            "published"
          ]
        }
      },
      "required": [
        "en"
      ]
    }
  },
  "required": [
    "package_schema_version",
    "debate_id",
    "short_code",
    "global_status",
    "created_at",
    "updated_at",
    "normative_versions",
    "core_files",
    "pages",
    "batches",
    "works",
    "validations",
    "release"
  ],
  "description": "Manifeste global du paquet, version 1.0, révision corrective 1.0.6. Les objets pages et lots sont intégrés et peuvent être projetés séparément."
}
