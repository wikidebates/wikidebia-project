{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "manual_remote_adoptions.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "debate_id",
    "decision",
    "entries"
  ],
  "properties": {
    "version": {
      "const": "wikidebia-manual-remote-adoptions-1.0"
    },
    "debate_id": {
      "type": "string",
      "minLength": 1
    },
    "decision": {
      "type": "string",
      "minLength": 10
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "language",
          "page_id",
          "title",
          "reason",
          "allow_proposed_change",
          "allowed_lifecycle_parameter_changes"
        ],
        "anyOf": [
          {
            "required": [
              "observed_revision_id"
            ]
          },
          {
            "required": [
              "observed_sha256"
            ]
          }
        ],
        "properties": {
          "language": {
            "enum": [
              "fr",
              "en"
            ]
          },
          "page_id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "observed_revision_id": {
            "type": "integer",
            "minimum": 1
          },
          "observed_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "allow_proposed_change": {
            "type": "boolean"
          },
          "reason": {
            "type": "string",
            "minLength": 10
          },
          "allowed_lifecycle_parameter_changes": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "enum": [
                "avancement",
                "avertissements-débat",
                "débats-connexes",
                "date-création",
                "progress",
                "debate-warnings",
                "related-debates",
                "creation-date",
                "avertissements-argument",
                "argument-warnings"
              ]
            }
          },
          "allowed_parameter_deletions": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "enum": [
                "justifications",
                "objections"
              ]
            }
          },
          "external_relations": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "relation",
                "page",
                "displayed_title"
              ],
              "properties": {
                "relation": {
                  "enum": [
                    "justification",
                    "objection"
                  ]
                },
                "page": {
                  "type": "string",
                  "minLength": 1
                },
                "displayed_title": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    }
  }
}
